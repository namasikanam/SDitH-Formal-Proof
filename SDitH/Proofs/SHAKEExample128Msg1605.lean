theorem absorption : absorb rate128 (message ++ suffix) = state1_24 := by
  have hlen : (padded rate128 (message ++ suffix)).length / rate128.value = 2 := by decide +kernel
  dsimp only [absorb]
  rw [hlen]
  simp only [absorbThrough]
  rw [input0, permutation0, input1, permutation1]

