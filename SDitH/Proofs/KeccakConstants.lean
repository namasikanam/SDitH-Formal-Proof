import SDitH.Proofs.Keccak

/-! Shared checked constants for the 24 submitted Keccak rounds. The proposed
8-bit LFSR states are untrusted data; a checked transition certificate and
induction establish the whole orbit. No native reduction is used. -/

namespace SDitH.Proofs.Keccak

open Spec.Keccak

set_option Elab.async false
set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

def lfsrStates : Vector (BitVec 8) 169 :=
  #v[0x1, 0x2, 0x4, 0x8, 0x10, 0x20, 0x40, 0x80, 0x71, 0xe2, 0xb5, 0x1b, 0x36, 0x6c, 0xd8, 0xc1, 0xf3, 0x97, 0x5f, 0xbe, 0xd, 0x1a, 0x34, 0x68, 0xd0, 0xd1, 0xd3, 0xd7, 0xdf, 0xcf, 0xef, 0xaf, 0x2f, 0x5e, 0xbc, 0x9, 0x12, 0x24, 0x48, 0x90, 0x51, 0xa2, 0x35, 0x6a, 0xd4, 0xd9, 0xc3, 0xf7, 0x9f, 0x4f, 0x9e, 0x4d, 0x9a, 0x45, 0x8a, 0x65, 0xca, 0xe5, 0xbb, 0x7, 0xe, 0x1c, 0x38, 0x70, 0xe0, 0xb1, 0x13, 0x26, 0x4c, 0x98, 0x41, 0x82, 0x75, 0xea, 0xa5, 0x3b, 0x76, 0xec, 0xa9, 0x23, 0x46, 0x8c, 0x69, 0xd2, 0xd5, 0xdb, 0xc7, 0xff, 0x8f, 0x6f, 0xde, 0xcd, 0xeb, 0xa7, 0x3f, 0x7e, 0xfc, 0x89, 0x63, 0xc6, 0xfd, 0x8b, 0x67, 0xce, 0xed, 0xab, 0x27, 0x4e, 0x9c, 0x49, 0x92, 0x55, 0xaa, 0x25, 0x4a, 0x94, 0x59, 0xb2, 0x15, 0x2a, 0x54, 0xa8, 0x21, 0x42, 0x84, 0x79, 0xf2, 0x95, 0x5b, 0xb6, 0x1d, 0x3a, 0x74, 0xe8, 0xa1, 0x33, 0x66, 0xcc, 0xe9, 0xa3, 0x37, 0x6e, 0xdc, 0xc9, 0xe3, 0xb7, 0x1f, 0x3e, 0x7c, 0xf8, 0x81, 0x73, 0xe6, 0xbd, 0xb, 0x16, 0x2c, 0x58, 0xb0, 0x11, 0x22, 0x44, 0x88, 0x61, 0xc2, 0xf5, 0x9b, 0x47, 0x8e]

def roundConstants : Vector (BitVec 64) 24 :=
  #v[0x1, 0x8082, 0x800000000000808a, 0x8000000080008000, 0x808b, 0x80000001, 0x8000000080008081, 0x8000000000008009, 0x8a, 0x88, 0x80008009, 0x8000000a, 0x8000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080, 0x800a, 0x800000008000000a, 0x8000000080008081, 0x8000000000008080, 0x80000001, 0x8000000080008008]

theorem lfsr_steps : ∀ t : Fin 168,
    rcStep lfsrStates[t.val] = lfsrStates[t.val + 1] := by decide +kernel

theorem lfsr_iterate (n : Nat) (h : n < 169) :
    rcStep^[n] 1 = lfsrStates[n] := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih (by omega)]
    exact lfsr_steps ⟨n, by omega⟩

theorem rc_of_table (n : Nat) (h : n < 168) :
    rc n = (lfsrStates[n]).getLsbD 0 := by
  rw [rc, Nat.mod_eq_of_lt (show n < 255 by omega), lfsr_iterate n (by omega)]

theorem roundConstant_table (ir : Fin 24) :
    roundConstant ir.val = roundConstants[ir] := by
  unfold roundConstant
  rw [rc_of_table (7 * ir.val) (by omega),
      rc_of_table (1 + 7 * ir.val) (by omega),
      rc_of_table (2 + 7 * ir.val) (by omega),
      rc_of_table (3 + 7 * ir.val) (by omega),
      rc_of_table (4 + 7 * ir.val) (by omega),
      rc_of_table (5 + 7 * ir.val) (by omega),
      rc_of_table (6 + 7 * ir.val) (by omega)]
  fin_cases ir <;> decide +kernel

end SDitH.Proofs.Keccak
