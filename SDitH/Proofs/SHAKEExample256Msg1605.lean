  rw [SDitH.Proofs.SHAKE.inject_bits]
  simp only [block, padded_bit]
  simp only [message, suffix, getD_append_if,
    List.length_append, List.length_cons, List.length_nil, List.length_ofFn]
  simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn]
  revert x y z
  decide +kernel

theorem absorption : absorb rate256 (message ++ suffix) = state1_24 := by
  have hlen : (padded rate256 (message ++ suffix)).length / rate256.value = 2 := by decide +kernel
  dsimp only [absorb]
  rw [hlen]
  simp only [absorbThrough]
  rw [input0, permutation0, input1, permutation1]

def expected : List Spec.DomainSeparation.Byte := [0x98, 0xd0, 0x93, 0xb0, 0x67, 0x47, 0x57, 0x60, 0x12, 0x4f, 0xfb, 0x92, 0x04, 0xa5, 0xb3, 0x27, 0xc6, 0xbb, 0x05, 0xc5, 0x4f, 0xf2, 0x34, 0xf0, 0xb4, 0x3f, 0xac, 0x72, 0x40, 0x41, 0x51, 0x66, 0xa8, 0xc7, 0x05, 0xea, 0x0d, 0x73, 0x9f, 0x08, 0x08, 0xb0, 0x65, 0x76, 0xd9, 0x96, 0x66, 0x2c, 0x1f, 0x37, 0x66, 0x94, 0xd9, 0x8f, 0x51, 0x57, 0x19, 0xb6, 0x64, 0x07, 0x72, 0x0d, 0xcf, 0x78]

theorem output_matches :
    List.ofFn (fun i : Fin 64 => byteStream .v message i.val) = expected := by
  unfold byteStream bitStream
  change List.ofFn (fun i : Fin 64 => (word (fun j : Fin 8 =>
    squeezeBit rate256 (absorb rate256 (message ++ suffix)) (8 * i.val + j.val))).toFin) = expected
  rw [absorption]
  decide

end SDitH.Proofs.SHAKE.Example256Msg1605
