  exact coprime_frobenius_of_euclid modulusBits r64
    64 euclid64 residue64 euclidChecked64

theorem full : polynomial modulusBits ∣ X ^ (2 ^ 128) - X := by
  simpa only [r128, polynomial, Bool.false_eq_true,
    if_false, if_true, mul_zero, add_zero, mul_one, zero_add] using
    residue128

end SDitH.Proofs.FieldCertificates.CategoryI
